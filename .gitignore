# Model weights and training artifacts
# Large checkpoints and feature caches stay untracked.
# Small probe exports in model/weights/ (*.joblib, *.json) ARE committable.
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.safetensors
model/checkpoints/
model/runs/
model/weights/*.npy
model/weights/*.npz

